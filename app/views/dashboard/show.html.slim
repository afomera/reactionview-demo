/ herb:slots client
.mx-auto.max-w-4xl.px-4.py-6
  header.mb-6.flex.items-baseline.justify-between
    h1.text-2xl.font-bold Dashboard
    p.hidden.text-sm.text-gray-500.sm:block every tile loads in parallel, scoped to itself
  .grid.grid-cols-2.gap-4.sm:grid-cols-3
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-1.text-xs.uppercase.tracking-wide.text-gray-500 Cities
      Async
        - sleep 0.5
        p data-herb-transition="stat-cities" class="text-2xl font-bold" = Geo.all_cities.size
        Fallback: p data-herb-transition="stat-cities" class="h-8 w-16 animate-pulse rounded bg-gray-200"
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-1.text-xs.uppercase.tracking-wide.text-gray-500 Countries
      Async
        - sleep 0.7
        p data-herb-transition="stat-countries" class="text-2xl font-bold" = Geo::DATA.values.flat_map(&:keys).uniq.size
        Fallback: p data-herb-transition="stat-countries" class="h-8 w-16 animate-pulse rounded bg-gray-200"
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-1.text-xs.uppercase.tracking-wide.text-gray-500 Continents
      Async
        - sleep 0.9
        p data-herb-transition="stat-continents" class="text-2xl font-bold" = Geo::DATA.size
        Fallback: p data-herb-transition="stat-continents" class="h-8 w-16 animate-pulse rounded bg-gray-200"
    section.col-span-2.rounded-lg.border.border-gray-200.p-4
      h2.mb-2.text-xs.uppercase.tracking-wide.text-gray-500 Cities per continent
      Async
        - sleep 1.1
        div data-herb-transition="chart-continents" class="space-y-2"
          - Geo.continent_city_counts.each do |entry|
            div herb-key="#{entry[:name]}" class="flex items-center gap-2 text-sm"
              span.w-28.shrink-0.text-gray-600 = entry[:name]
              .h-4.flex-1.rounded.bg-gray-100
                .h-4.rounded.bg-lime-400 style="width: #{entry[:percent]}%"
              span.w-6.text-right.font-semibold.tabular-nums = entry[:count]
        Fallback
          div data-herb-transition="chart-continents" class="space-y-2"
            .h-4.animate-pulse.rounded.bg-gray-200
            .h-4.w-2/3.animate-pulse.rounded.bg-gray-200
            .h-4.w-1/3.animate-pulse.rounded.bg-gray-200
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-1.text-xs.uppercase.tracking-wide.text-gray-500 Server time
      Async poll="1000"
        p data-herb-transition="stat-clock" class="text-2xl font-bold tabular-nums" = Time.now.strftime("%H:%M:%S")
        Fallback: p data-herb-transition="stat-clock" class="h-8 w-24 animate-pulse rounded bg-gray-200"
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-1.text-xs.uppercase.tracking-wide.text-gray-500 On rotation
      Async poll="4000"
        - album = Music.albums.sample
        div data-herb-transition="tile-rotation"
          p.truncate.font-semibold = album[:title]
          p.truncate.text-sm.text-gray-500 = album[:artist]
          p.mt-1.text-xs.text-gray-400 #{album[:year]} &middot; #{Music::TRACKS[album[:id]].size} tracks
        Fallback
          div data-herb-transition="tile-rotation" class="space-y-2"
            .h-4.w-32.animate-pulse.rounded.bg-gray-200
            .h-3.w-24.animate-pulse.rounded.bg-gray-200
            .h-3.w-20.animate-pulse.rounded.bg-gray-200
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-2.text-xs.uppercase.tracking-wide.text-gray-500 Services
      Async poll="2500"
        ul data-herb-transition="tile-services" class="space-y-1.5 text-sm"
          - Ops.services.each do |service|
            li herb-key="#{service[:name]}" class="flex items-center gap-2"
              span.h-2.w-2.rounded-full> class="#{service[:up] ? "bg-emerald-500" : "bg-amber-500"}"
              span.text-gray-600> = service[:name]
              span.ml-auto.text-xs class="#{service[:up] ? "text-emerald-600" : "text-amber-600"}" = service[:label]
        Fallback
          ul data-herb-transition="tile-services" class="space-y-2"
            li.h-3.animate-pulse.rounded.bg-gray-200
            li.h-3.animate-pulse.rounded.bg-gray-200
            li.h-3.animate-pulse.rounded.bg-gray-200
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-2.text-xs.uppercase.tracking-wide.text-gray-500 Latest releases
      Async
        - sleep 0.8
        ul data-herb-transition="tile-releases" class="space-y-1 text-sm"
          - Music.latest_releases.each do |album|
            li herb-key="#{album[:id]}" class="flex items-baseline gap-2"
              span.truncate.text-gray-700> = album[:title]
              span.ml-auto.text-xs.tabular-nums.text-gray-400 = album[:year]
        Fallback
          ul data-herb-transition="tile-releases" class="space-y-2"
            li.h-3.animate-pulse.rounded.bg-gray-200
            li.h-3.w-4/5.animate-pulse.rounded.bg-gray-200
            li.h-3.animate-pulse.rounded.bg-gray-200
            li.h-3.w-3/4.animate-pulse.rounded.bg-gray-200
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-1.text-xs.uppercase.tracking-wide.text-gray-500 Largest
      Async
        - sleep 0.8
        p data-herb-transition="stat-largest" class="text-2xl font-bold" = Geo::DATA.max_by { |_, countries| countries.values.flat_map(&:values).flatten.size }[0]
        Fallback: p data-herb-transition="stat-largest" class="h-8 w-24 animate-pulse rounded bg-gray-200"
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-1.text-xs.uppercase.tracking-wide.text-gray-500 States
      Async
        - sleep 0.6
        p data-herb-transition="stat-states" class="text-2xl font-bold" = Geo::DATA.values.flat_map(&:values).flat_map(&:keys).size
        Fallback: p data-herb-transition="stat-states" class="h-8 w-16 animate-pulse rounded bg-gray-200"
    section.rounded-lg.border.border-gray-200.p-4
      h2.mb-2.text-xs.uppercase.tracking-wide.text-gray-500 Longest album
      Async
        - sleep 1.0
        - longest_id, longest_tracks = Music::TRACKS.max_by { |_, tracks| tracks.size }
        div data-herb-transition="tile-longest"
          p.truncate.font-semibold = Music.title(longest_id)
          .mt-2.h-2.rounded.bg-gray-100
            .h-2.rounded.bg-lime-400 style="width: 100%"
          p.mt-1.text-xs.text-gray-400 #{longest_tracks.size} tracks
        Fallback
          div data-herb-transition="tile-longest" class="space-y-2"
            .h-4.w-28.animate-pulse.rounded.bg-gray-200
            .h-2.animate-pulse.rounded.bg-gray-200
            .h-3.w-16.animate-pulse.rounded.bg-gray-200
